---
// src/components/sections/catalog/CatalogGrid.astro
import { collectionCategories, productList, serviceList } from '../../../config/content'
import { siteConfig } from '../../../config/site'
---

<section x-data="{ activeTab: 'all' }" class="relative bg-surface py-12 lg:py-24">
  <div class="mx-auto max-w-[96rem] px-4 sm:px-6 lg:px-12">

    <!-- Horizontal Scroll Filter Bar (Mobile Optimized) -->
    <div class="reveal border-b border-border pb-4">
      <div class="flex items-center gap-2 sm:gap-4 overflow-x-auto no-scrollbar scroll-smooth pb-2 -mx-4 px-4 sm:mx-0 sm:px-0">
        {
          collectionCategories.map((cat) => (
            <button
              @click={`activeTab = '${cat.id}'`}
              :class={`activeTab === '${cat.id}' ? 'bg-primary text-white border-primary' : 'bg-transparent text-primary border-border hover:border-accent'`}
              class="shrink-0 border px-4 py-2.5 sm:px-6 sm:py-3 font-heading text-[11px] sm:text-sm font-bold uppercase tracking-widest transition-all duration-300 cursor-pointer whitespace-nowrap"
            >
              {cat.label}
            </button>
          ))
        }
      </div>
    </div>

    <!-- Product Grid Section (Mobile 2 Kolom: grid-cols-2) -->
    <div class="mt-8 sm:mt-12 grid grid-cols-2 gap-3 sm:gap-8 lg:grid-cols-4 lg:gap-10">
      {
        productList.map((product) => (
          <div
            x-show={`activeTab === 'all' || activeTab === '${product.category}'`}
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0 scale-95"
            x-transition:enter-end="opacity-100 scale-100"
            class="group relative flex flex-col justify-between border border-border bg-surface-card p-3 sm:p-5 transition-all duration-500 hover:-translate-y-1 hover:shadow-xl"
          >
            <div>
              <!-- Link Detail via Foto -->
              <a href={`/koleksi/${product.id}`} class="block relative aspect-[3/4] w-full overflow-hidden border border-border bg-surface">
                <img
                  src={product.image}
                  alt={product.name}
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
                {product.badge && (
                  <span class="absolute top-2 left-2 sm:top-3 sm:left-3 bg-primary/90 px-2 py-1 sm:px-3.5 sm:py-1.5 text-[9px] sm:text-xs font-bold uppercase tracking-widest text-white backdrop-blur-xs">
                    {product.badge}
                  </span>
                )}
              </a>

              <div class="mt-3 sm:mt-5">
                <span class="text-[10px] sm:text-xs font-bold uppercase tracking-widest text-accent">
                  {product.categoryLabel}
                </span>

                <!-- Link Detail via Judul -->
                <a href={`/koleksi/${product.id}`} class="block group-hover:text-accent transition-colors">
                  <h3 class="font-heading mt-1 sm:mt-1.5 text-sm sm:text-xl font-bold uppercase tracking-wide text-primary line-clamp-1">
                    {product.name}
                  </h3>
                </a>

                <p class="mt-1 sm:mt-2 text-xs sm:text-sm font-light leading-relaxed text-secondary/80 line-clamp-2 hidden sm:block">
                  {product.description}
                </p>
              </div>
            </div>

            <div class="mt-4 sm:mt-6 border-t border-border/80 pt-3 sm:pt-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 sm:gap-3">
              <div>
                <span class="block text-[9px] sm:text-xs uppercase tracking-wider text-secondary/60">Mulai Dari</span>
                <span class="font-heading text-xs sm:text-base font-bold text-primary">{product.price}</span>
              </div>

              <div class="flex items-center gap-1.5 sm:gap-2 w-full sm:w-auto">
                <a
                  href={`/koleksi/${product.id}`}
                  class="flex-1 sm:flex-none text-center border border-border bg-transparent px-2 py-1.5 sm:px-3 sm:py-2 text-[10px] sm:text-xs font-bold uppercase tracking-widest text-primary hover:border-primary transition-colors"
                >
                  Detail
                </a>
                <a
                  href={`https://wa.me/${siteConfig.contact.whatsapp}?text=Halo%20Aura%20Fleur,%20saya%20tertarik%20memesan%20*${encodeURIComponent(product.name)}*.`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex-1 sm:flex-none text-center border border-primary bg-primary px-2.5 py-1.5 sm:px-4 sm:py-2 text-[10px] sm:text-xs font-bold uppercase tracking-widest text-white transition-colors hover:bg-primary-hover"
                >
                  Pesan
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Bespoke Services Showcase Grid (Tetap 1 kolom di mobile, 2 kolom di md) -->
    <div
      x-show="activeTab === 'all' || activeTab === 'wedding' || activeTab === 'corporate'"
      class="mt-16 border-t border-border pt-16"
    >
      <div class="mb-8">
        <span class="text-xs sm:text-sm font-bold uppercase tracking-[0.3em] text-accent">
          Bespoke Service Packages
        </span>
        <h3 class="font-heading mt-1 text-2xl font-normal uppercase text-primary sm:text-5xl">
          Layanan Dekorasi & Subskripsi
        </h3>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {
          serviceList.map((service) => (
            <div
              x-show={`activeTab === 'all' || (activeTab === 'wedding' && '${service.id}'.includes('wedding')) || (activeTab === 'corporate' && '${service.id}'.includes('corporate'))`}
              class="group relative border border-border bg-surface-card p-5 sm:p-8 flex flex-col justify-between transition-all hover:shadow-xl"
            >
              <div>
                <div class="aspect-[16/9] w-full overflow-hidden border border-border">
                  <img
                    src={service.image}
                    alt={service.title}
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                </div>
                <span class="mt-6 block text-xs sm:text-sm font-bold uppercase tracking-widest text-accent">
                  {service.subtitle}
                </span>
                <h4 class="font-heading mt-1 text-xl sm:text-3xl font-bold uppercase text-primary">
                  {service.title}
                </h4>
                <p class="mt-3 text-sm font-light leading-relaxed text-secondary/80 sm:text-base">
                  {service.description}
                </p>

                <!-- Features List -->
                <ul class="mt-6 flex flex-col gap-2.5 border-t border-border/60 pt-5 text-sm text-primary/90">
                  {service.features.map((feat) => (
                    <li class="flex items-center gap-2.5">
                      <span class="h-2 w-2 rounded-full bg-accent"></span>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Tombol Konsultasi Layanan -->
              <div class="mt-8 border-t border-border pt-6">
                <a
                  href={`https://wa.me/${siteConfig.contact.whatsapp}?text=Halo%20Aura%20Fleur,%20saya%20ingin%20konsultasi%20layanan%20*${encodeURIComponent(service.title)}*.`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block w-full sm:w-auto text-center border border-primary bg-primary px-7 py-3.5 text-xs font-bold uppercase tracking-widest text-white transition-colors hover:bg-primary-hover"
                >
                  Konsultasi Layanan Ini
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>

  </div>
</section>