---
// src/components/sections/gallery/GalleryCta.astro
import { siteConfig } from '../../../config/site';
---

<section
  class="bg-surface border-border relative overflow-hidden border-t py-24 text-center lg:py-36"
>
  <div class="relative z-10 mx-auto max-w-5xl px-6 lg:px-12">
    <span
      class="reveal text-accent mb-3 block text-xs font-semibold tracking-[0.3em] uppercase"
    >
      Realize Your Vision
    </span>

    <h2
      class="reveal font-heading text-primary text-4xl leading-tight font-normal uppercase sm:text-6xl"
    >
      Tertarik Mewujudkan Estetika Serupa?
    </h2>

    <p
      class="reveal text-secondary/80 mt-6 text-sm leading-relaxed font-light sm:text-base"
    >
      Konsultasikan konsep dekorasi acara atau kebutuhan floral bespoke Anda
      bersama Master Florist kami.
    </p>

    <div class="reveal mt-10 flex justify-center">
      <a
        href={`https://wa.me/${siteConfig.contact.whatsapp}?text=Halo%20Aura%20Fleur,%20saya%20tertarik%20mewujudkan%20konsep%20floral%20seperti%20di%20galeri.`}
        target="_blank"
        rel="noopener noreferrer"
        class="border-primary bg-primary hover:bg-primary-hover border px-9 py-4 text-xs font-bold tracking-widest text-white uppercase transition-all hover:scale-105"
      >
        Konsultasi WA Concierge
      </a>
    </div>
  </div>
</section>
