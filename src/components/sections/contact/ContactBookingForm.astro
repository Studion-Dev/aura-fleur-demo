---
// src/components/sections/contact/ContactBookingForm.astro
import { siteConfig } from '../../../config/site';
---

<section
  class="bg-surface relative overflow-hidden pt-32 pb-20 lg:pt-40 lg:pb-28"
>
  <div class="mx-auto max-w-[96rem] px-6 lg:px-12">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Left Side: Editorial Info (5 Cols) -->
      <div class="reveal flex flex-col justify-between lg:col-span-5">
        <div>
          <span
            class="text-accent mb-4 block text-xs font-semibold tracking-[0.3em] uppercase sm:text-sm"
          >
            Private Appointment
          </span>
          <h1
            class="font-heading text-primary text-4xl leading-[1.02] font-normal uppercase sm:text-6xl lg:text-7xl"
          >
            Hubungi Concierge Kami
          </h1>
          <p
            class="text-secondary/80 mt-6 text-base leading-relaxed font-light sm:text-lg"
          >
            Diskusikan rencana buket eksklusif, konsep dekorasi pernikahan, atau
            langganan bunga kantor Anda bersama master florist kami secara
            langsung.
          </p>
        </div>

        <div class="border-border mt-10 flex flex-col gap-6 border-t pt-8">
          <div>
            <h2
              class="font-heading text-accent text-xs font-semibold tracking-widest uppercase"
            >
              Direct WhatsApp
            </h2>
            <a
              href={`https://wa.me/${siteConfig.contact.whatsapp}`}
              target="_blank"
              rel="noopener noreferrer"
              class="font-heading text-primary hover:text-accent mt-1 inline-block text-xl font-bold transition-colors"
            >
              {siteConfig.contact.whatsappFormatted}
            </a>
          </div>

          <div>
            <h2
              class="font-heading text-accent text-xs font-semibold tracking-widest uppercase"
            >
              Email Consultation
            </h2>
            <a
              href={`mailto:${siteConfig.contact.email}`}
              class="text-primary hover:text-accent mt-1 inline-block text-base font-medium transition-colors"
            >
              {siteConfig.contact.email}
            </a>
          </div>
        </div>
      </div>

      <!-- Right Side: Booking Form (7 Cols) -->
      <div
        class="reveal-right border-border bg-surface-card border p-8 shadow-sm sm:p-12 lg:col-span-7"
      >
        <h2
          class="font-heading text-primary text-2xl font-bold tracking-wide uppercase"
        >
          Formulir Reservasi Konsultasi
        </h2>
        <div class="bg-accent my-6 h-[1px] w-16"></div>

        <form
          x-data="{
            name: '',
            phone: '',
            service: 'Luxury Wedding',
            date: '',
            message: '',
            sendWA() {
              const text = `Halo Aura Fleur Concierge, nama saya *${this.name}*.\n\nSaya ingin membuat janji konsultasi untuk: *${this.service}*\nRencana Tanggal: *${this.date}*\nNomor Kontak: *${this.phone}*\nCatatan Tambahan: ${this.message}`;
              window.open(`https://wa.me/${siteConfig.contact.whatsapp}?text=${encodeURIComponent(text)}`, '_blank');
            }
          }"
          x-on:submit.prevent="sendWA()"
          class="flex flex-col gap-6"
        >
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
              <label
                class="text-primary mb-2 block text-xs font-semibold tracking-wider uppercase"
              >
                Nama Lengkap *
              </label>
              <input
                type="text"
                x-model="name"
                required
                placeholder="cth. Clara Setyadjaya"
                class="border-border bg-surface text-primary focus:border-primary w-full border px-4 py-3.5 text-xs focus:outline-none"
              />
            </div>

            <div>
              <label
                class="text-primary mb-2 block text-xs font-semibold tracking-wider uppercase"
              >
                Nomor WhatsApp *
              </label>
              <input
                type="tel"
                x-model="phone"
                required
                placeholder="cth. 081234567890"
                class="border-border bg-surface text-primary focus:border-primary w-full border px-4 py-3.5 text-xs focus:outline-none"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
              <label
                class="text-primary mb-2 block text-xs font-semibold tracking-wider uppercase"
              >
                Jenis Layanan *
              </label>
              <select
                x-model="service"
                class="border-border bg-surface text-primary focus:border-primary w-full border px-4 py-3.5 text-xs focus:outline-none"
              >
                <option value="Luxury Wedding Styling"
                  >Luxury Wedding Styling</option
                >
                <option value="Corporate Subscription"
                  >Corporate & Hospitality</option
                >
                <option value="Bespoke Custom Bouquet"
                  >Bespoke Custom Bouquet</option
                >
                <option value="Private Event Floral"
                  >Private Event Floral</option
                >
              </select>
            </div>

            <div>
              <label
                class="text-primary mb-2 block text-xs font-semibold tracking-wider uppercase"
              >
                Rencana Tanggal Acara *
              </label>
              <input
                type="date"
                x-model="date"
                required
                class="border-border bg-surface text-primary focus:border-primary w-full border px-4 py-3.5 text-xs focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label
              class="text-primary mb-2 block text-xs font-semibold tracking-wider uppercase"
            >
              Pesan / Catatan Khusus
            </label>
            <textarea
              x-model="message"
              rows="4"
              placeholder="Ceritakan konsep warna atau kebutuhan acara Anda..."
              class="border-border bg-surface text-primary focus:border-primary w-full border px-4 py-3.5 text-xs focus:outline-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="border-primary bg-primary hover:bg-primary-hover border py-4 text-xs font-semibold tracking-widest text-white uppercase transition-all duration-300 focus:outline-none"
          >
            Kirim Permintaan Konsultasi (WA Direct)
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
