---
// src/components/sections/contact/AtelierInfoMap.astro
import { siteConfig } from '../../../config/site';
---

<section class="border-border bg-surface relative border-t py-20 lg:py-32">
  <div class="mx-auto max-w-[96rem] px-6 lg:px-12">
    <div
      class="grid grid-cols-1 items-stretch gap-12 lg:grid-cols-12 lg:gap-16"
    >
      <!-- Info Details (5 Cols) -->
      <div
        class="reveal border-border bg-surface-card flex flex-col justify-between border p-8 shadow-xs sm:p-12 lg:col-span-5"
      >
        <div>
          <span
            class="text-accent mb-3 block text-xs font-semibold tracking-[0.3em] uppercase sm:text-sm"
          >
            Visit Us
          </span>
          <h2
            class="font-heading text-primary text-3xl leading-tight font-normal uppercase sm:text-4xl"
          >
            Aura Fleur Atelier
          </h2>
          <div class="bg-accent my-6 h-[1px] w-16"></div>

          <div class="flex flex-col gap-6">
            <div>
              <h3
                class="text-primary text-xs font-bold tracking-wider uppercase"
              >
                Alamat Atelier:
              </h3>
              <p class="text-secondary/80 mt-1 text-sm leading-relaxed">
                {siteConfig.contact.address}
              </p>
            </div>

            <div>
              <h3
                class="text-primary text-xs font-bold tracking-wider uppercase"
              >
                Jam Operasional:
              </h3>
              <p class="text-secondary/80 mt-1 text-sm leading-relaxed">
                {siteConfig.contact.hours}
              </p>
            </div>
          </div>
        </div>

        <div class="border-border/80 mt-8 border-t pt-6">
          <p class="text-secondary/60 text-xs leading-relaxed">
            *Kunjungan konsultasi tatap muka disarankan untuk melakukan janji
            temu terlebih dahulu.
          </p>
        </div>
      </div>

      <!-- Google Maps Embed (7 Cols) -->
      <div
        class="reveal-right border-border aspect-[16/10] w-full overflow-hidden border shadow-md lg:col-span-7 lg:aspect-auto"
      >
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3966.273183786088!2d106.80665407584109!3d-6.227670993760434!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69f15049389e1b%3A0xe75ef980bb6e2e03!2sSenopati%2C%20Kebayoran%20Baru%2C%20South%20Jakarta%20City%2C%20Jakarta!5e0!3m2!1sen!2sid!4v1700000000000!5m2!1sen!2sid"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Aura Fleur Atelier Location Map"
          class="h-full w-full opacity-90 contrast-125 grayscale transition-all duration-500 hover:opacity-100 hover:grayscale-0"
        ></iframe>
      </div>
    </div>
  </div>
</section>
