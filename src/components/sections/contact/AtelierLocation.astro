---
// src/components/sections/contact/AtelierLocation.astro
import { siteConfig } from '../../../config/site';
---

<section
  class="bg-surface border-border relative overflow-hidden border-t py-20 lg:py-28"
>
  <div class="mx-auto max-w-[96rem] px-6 lg:px-12">
    <div class="reveal mb-12">
      <span
        class="text-accent mb-3 block text-xs font-semibold tracking-[0.3em] uppercase"
      >
        Physical Atelier
      </span>
      <h2
        class="font-heading text-primary text-3xl leading-tight font-normal uppercase sm:text-5xl"
      >
        Kunjungi Studio Kami
      </h2>
    </div>

    <!-- Split Screen: Address Card (Left) & Map Embed (Right) -->
    <div class="grid grid-cols-1 items-stretch gap-8 lg:grid-cols-12 lg:gap-12">
      <!-- Left Card: Address & Operating Hours -->
      <div
        class="reveal border-border bg-surface-card flex flex-col justify-between border p-8 shadow-xl lg:col-span-5 lg:p-10"
      >
        <div>
          <span class="text-accent text-xs font-bold tracking-widest uppercase"
            >Aura Fleur Main Atelier</span
          >
          <h3
            class="font-heading text-primary mt-2 text-2xl font-bold uppercase"
          >
            {siteConfig.name}
          </h3>

          <div class="bg-accent/60 my-6 h-[1px] w-12"></div>

          <!-- Alamat Fisik Direct dari siteConfig.contact.address -->
          <p class="text-secondary/80 text-sm leading-relaxed font-light">
            {siteConfig.contact.address}
          </p>

          <p
            class="text-primary mt-4 text-xs font-semibold tracking-wider uppercase"
          >
            {siteConfig.contact.hours}
          </p>
        </div>

        <div class="border-border mt-8 border-t pt-6">
          <a
            href="https://maps.google.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary hover:text-accent inline-flex items-center gap-2 text-xs font-bold tracking-widest uppercase transition-colors"
          >
            <span>Buka di Google Maps</span>
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Card: Grayscale Google Maps Embed -->
      <div
        class="reveal-right border-border min-h-[350px] overflow-hidden border shadow-xl lg:col-span-7"
      >
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d126920.26282302302!2d106.7596378!3d-6.229728!2m3!1f0!0f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e69f3e945e325d1%3A0x2e1189d2c20e1d0!2sJakarta%20South%2C%20South%20Jakarta%20City%2C%20Jakarta!5e0!3m2!1sen!2sid!4v1700000000000!5m2!1sen!2sid"
          width="100%"
          height="100%"
          style="border:0; filter: grayscale(100%) contrast(90%);"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </div>
</section>
