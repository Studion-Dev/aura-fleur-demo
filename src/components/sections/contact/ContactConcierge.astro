---
// src/components/sections/contact/ContactConcierge.astro
import { siteConfig } from '../../../config/site';
---

<section class="bg-surface relative overflow-hidden py-20 lg:py-32">
  <div class="mx-auto max-w-[96rem] px-6 lg:px-12">
    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- SISI KIRI (5 Cols): Direct Concierge Info -->
      <div class="reveal lg:col-span-5">
        <span
          class="text-accent mb-3 block text-xs font-semibold tracking-[0.3em] uppercase"
        >
          Direct Line
        </span>
        <h2
          class="font-heading text-primary text-3xl leading-tight font-normal uppercase sm:text-5xl"
        >
          Layanan Concierge
        </h2>

        <div class="border-border mt-10 flex flex-col gap-8 border-t pt-8">
          <div>
            <span
              class="text-accent block text-[10px] font-bold tracking-widest uppercase"
              >WhatsApp Concierge</span
            >
            <a
              href={`https://wa.me/${siteConfig.contact.whatsapp}`}
              class="font-heading text-primary hover:text-accent mt-1 text-xl font-bold transition-colors"
            >
              +{siteConfig.contact.whatsapp}
            </a>
          </div>

          <div>
            <span
              class="text-accent block text-[10px] font-bold tracking-widest uppercase"
              >Email Inquiries</span
            >
            <a
              href={`mailto:${siteConfig.contact.email}`}
              class="font-heading text-primary hover:text-accent mt-1 text-xl font-bold transition-colors"
            >
              {siteConfig.contact.email}
            </a>
          </div>

          <div>
            <span
              class="text-accent block text-[10px] font-bold tracking-widest uppercase"
              >Jam Operasional Atelier</span
            >
            <p
              class="font-heading text-primary mt-1 text-sm font-semibold uppercase"
            >
              Senin – Sabtu: 09:00 – 18:00 WIB
            </p>
            <p class="text-secondary/70 mt-0.5 text-xs">
              Minggu & Hari Libur: Janji Temu Khusus
            </p>
          </div>
        </div>
      </div>

      <!-- SISI KANAN (7 Cols): Direct WhatsApp Reservation Form -->
      <div
        class="reveal-right border-border bg-surface-card border p-8 shadow-xl lg:col-span-7 lg:p-12"
        x-data="{ name: '', eventType: 'Wedding', date: '', notes: '' }"
      >
        <span
          class="text-accent mb-2 block text-xs font-semibold tracking-[0.3em] uppercase"
        >
          Private Appointment
        </span>
        <h3
          class="font-heading text-primary text-2xl font-bold tracking-wide uppercase sm:text-3xl"
        >
          Form Reservasi Konsultasi
        </h3>

        <form
          class="mt-8 flex flex-col gap-6"
          @submit.prevent={`window.open('https://wa.me/${siteConfig.contact.whatsapp}?text=Halo%20Aura%20Fleur,%20saya%20' + encodeURIComponent(name) + '%20ingin%20reservasi%20konsultasi%20' + encodeURIComponent(eventType) + '%20pada%20tanggal%20' + encodeURIComponent(date) + '.%20Catatan:%20' + encodeURIComponent(notes), '_blank')`}
        >
          <div>
            <label
              class="text-primary block text-xs font-bold tracking-wider uppercase"
              >Nama Lengkap</label
            >
            <input
              x-model="name"
              type="text"
              required
              placeholder="Nama Anda"
              class="border-border bg-surface text-primary focus:border-accent mt-2 w-full border px-4 py-3 text-sm focus:outline-none"
            />
          </div>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
              <label
                class="text-primary block text-xs font-bold tracking-wider uppercase"
                >Jenis Layanan</label
              >
              <select
                x-model="eventType"
                class="border-border bg-surface text-primary focus:border-accent mt-2 w-full border px-4 py-3 text-sm focus:outline-none"
              >
                <option value="Wedding Styling">Wedding Styling</option>
                <option value="Corporate Subscription"
                  >Corporate Subscription</option
                >
                <option value="Bespoke Bouquet">Bespoke Bouquet</option>
                <option value="Private Event">Private Event</option>
              </select>
            </div>

            <div>
              <label
                class="text-primary block text-xs font-bold tracking-wider uppercase"
                >Rencana Tanggal Acara</label
              >
              <input
                x-model="date"
                type="date"
                required
                class="border-border bg-surface text-primary focus:border-accent mt-2 w-full border px-4 py-3 text-sm focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label
              class="text-primary block text-xs font-bold tracking-wider uppercase"
              >Catatan / Konsep (Opsional)</label
            >
            <textarea
              x-model="notes"
              rows="4"
              placeholder="Ceritakan ide warna atau jenis bunga yang Anda bayangkan..."
              class="border-border bg-surface text-primary focus:border-accent mt-2 w-full border px-4 py-3 text-sm focus:outline-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="border-primary bg-primary hover:bg-primary-hover mt-2 border py-4 text-xs font-bold tracking-widest text-white uppercase transition-all hover:scale-[1.01]"
          >
            Kirim Reservasi via WA
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
