---
// src/components/sections/contact/ContactHero.astro
import { siteConfig } from '../../../config/site';
---

<section
  class="bg-surface border-border relative w-full overflow-hidden border-b pt-32 pb-16 lg:flex lg:h-[40vh] lg:items-center lg:py-0"
>
  <!-- Background Image Bright & Light Overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1526047932273-341f2a7631f9?q=80&w=1600&auto=format&fit=crop"
      alt="Aura Fleur Atelier Entrance"
      class="h-full w-full object-cover object-center opacity-25 brightness-110 contrast-90 filter"
    />
    <div
      class="from-surface/95 via-surface/85 to-surface/60 absolute inset-0 bg-gradient-to-r"
    >
    </div>
  </div>

  <!-- Luxury Grid Pattern Background -->
  <div class="pointer-events-none absolute inset-0 z-0 opacity-20">
    <svg
      class="h-full w-full"
      width="100%"
      height="100%"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <pattern
          id="contact-hero-grid"
          width="48"
          height="48"
          patternUnits="userSpaceOnUse"
        >
          <path
            d="M 48 0 L 0 0 0 48"
            fill="none"
            stroke="#D4CEA3"
            stroke-width="1.2"></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#contact-hero-grid)"></rect>
    </svg>
  </div>

  <div class="relative z-10 mx-auto w-full max-w-[96rem] px-6 lg:px-12">
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12">
      <div class="reveal lg:col-span-8">
        <span
          class="text-accent mb-3 block text-xs font-semibold tracking-[0.3em] uppercase"
        >
          Atelier & Concierge Service
        </span>
        <h1
          class="font-heading text-primary text-4xl leading-[0.98] font-normal uppercase sm:text-6xl lg:text-7xl"
        >
          Kontak & Reservasi
        </h1>
      </div>

      <div class="reveal-right lg:col-span-4 lg:text-right">
        <p
          class="text-primary/80 text-xs font-medium tracking-widest uppercase sm:text-sm lg:ml-auto lg:max-w-xs"
        >
          Jadwalkan konsultasi private atau hubungi concierge kami untuk pesanan
          kustom.
        </p>
      </div>
    </div>
  </div>
</section>
