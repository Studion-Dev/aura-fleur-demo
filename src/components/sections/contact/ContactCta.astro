---
// src/components/sections/contact/ContactCta.astro
import { siteConfig } from '../../../config/site';
---

<section
  class="bg-primary border-border relative overflow-hidden border-t py-24 text-center text-white lg:py-36"
>
  <div class="relative z-10 mx-auto max-w-4xl px-6 lg:px-12">
    <span
      class="reveal text-accent mb-3 block text-xs font-semibold tracking-[0.3em] uppercase"
    >
      Start Your Journey
    </span>

    <h2
      class="reveal font-heading text-4xl leading-tight font-normal text-white uppercase sm:text-6xl"
    >
      Siap Mewujudkan Momen Keanggunan Anda?
    </h2>

    <div class="reveal mt-10 flex justify-center">
      <a
        href={`https://wa.me/${siteConfig.contact.whatsapp}?text=Halo%20Aura%20Fleur,%20saya%20ingin%20reservasi%20janji%20temu%20dengan%20Master%20Florist.`}
        target="_blank"
        rel="noopener noreferrer"
        class="border-accent bg-accent hover:bg-accent-hover border px-9 py-4 text-xs font-bold tracking-widest text-white uppercase transition-all hover:scale-105"
      >
        Reservasi Master Florist
      </a>
    </div>
  </div>
</section>
