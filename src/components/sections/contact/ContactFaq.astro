---
// src/components/sections/contact/ContactFAQ.astro
import { faqList } from '../../../config/content'
---

<section class="relative border-t border-border bg-surface py-20 lg:py-32">
  <div class="mx-auto max-w-[96rem] px-6 lg:px-12">
    <!-- Header -->
    <div class="reveal max-w-3xl">
      <span class="mb-3 block text-xs font-semibold uppercase tracking-[0.3em] text-accent sm:text-sm">
        Pertanyaan Umum
      </span>
      <h2 class="font-heading text-4xl font-normal uppercase leading-tight text-primary sm:text-6xl lg:text-7xl">
        Frequently Asked Questions
      </h2>
    </div>

    <!-- Accordion List (Alpine.js x-collapse) -->
    <div class="reveal mt-16 flex flex-col gap-4 mx-auto max-w-4xl">
      {
        faqList.map((item, index) => (
          <div
            x-data="{ open: false }"
            class="border border-border bg-surface-card transition-colors"
          >
            <button
              type="button"
              x-on:click="open = !open"
              class="flex w-full items-center justify-between p-6 text-left focus:outline-none"
              :aria-expanded="open"
            >
              <span class="font-heading text-base font-bold uppercase tracking-wide text-primary sm:text-lg">
                {item.question}
              </span>
              <span class="ml-4 flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-primary/20 text-primary transition-transform duration-300" :class="open ? 'rotate-180 bg-primary text-white' : ''">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </span>
            </button>

            <div x-show="open" x-collapse x-cloak>
              <div class="border-t border-border/60 p-6 text-sm leading-relaxed text-secondary/80 sm:text-base">
                {item.answer}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>