---
// src/components/sections/services/ProcessSteps.astro
import { bookingProcess } from '../../../config/content';
---

<section class="border-border bg-surface relative border-t py-20 lg:py-32">
  <div class="mx-auto max-w-[96rem] px-6 lg:px-12">
    <!-- Header -->
    <div class="reveal max-w-3xl">
      <span
        class="text-accent mb-3 block text-xs font-semibold tracking-[0.3em] uppercase sm:text-sm"
      >
        Seamless Workflow
      </span>
      <h2
        class="font-heading text-primary text-4xl leading-tight font-normal uppercase sm:text-6xl lg:text-7xl"
      >
        Alur Pemesanan Bespoke
      </h2>
      <p
        class="text-secondary/80 mt-4 text-base leading-relaxed font-light sm:text-lg"
      >
        Tiga langkah sederhana mewujudkan penataan seni floral eksklusif dari
        ide awal hingga eksekusi di lokasi.
      </p>
    </div>

    <!-- Steps Process Grid (3 Columns) -->
    <div class="mt-16 grid grid-cols-1 gap-10 md:grid-cols-3 lg:gap-12">
      {
        bookingProcess.map((item, index) => (
          <div
            class={`reveal delay-${(index + 1) * 150} border-border bg-surface-card relative flex flex-col justify-between border p-8 shadow-xs sm:p-10`}
          >
            <div>
              <span class="font-heading text-accent/50 mb-6 block text-5xl font-bold">
                {item.step}
              </span>
              <h3 class="font-heading text-primary text-xl font-bold tracking-wide uppercase">
                {item.title}
              </h3>
              <p class="text-secondary/75 mt-3 text-sm leading-relaxed sm:text-base">
                {item.description}
              </p>
            </div>
            <div class="border-border/60 mt-8 border-t pt-4">
              <span class="text-accent text-[10px] font-semibold tracking-widest uppercase">
                Langkah {index + 1} Dari 3
              </span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
