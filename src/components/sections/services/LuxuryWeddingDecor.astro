---
// src/components/sections/services/LuxuryWeddingDecor.astro
import { serviceList } from '../../../config/content';
import { siteConfig } from '../../../config/site';

const weddingService = serviceList[0];
---

<section
  class="bg-surface relative overflow-hidden pt-32 pb-20 lg:pt-40 lg:pb-28"
>
  <div class="mx-auto max-w-[96rem] px-6 lg:px-12">
    <!-- Header Editorial -->
    <div class="reveal max-w-4xl">
      <span
        class="text-accent mb-4 block text-xs font-semibold tracking-[0.3em] uppercase sm:text-sm"
      >
        Haute Couture Weddings
      </span>
      <h1
        class="font-heading text-primary text-4xl leading-[1.02] font-normal uppercase sm:text-6xl lg:text-7xl"
      >
        {weddingService.title}
      </h1>
      <p
        class="text-secondary/80 mt-6 max-w-3xl text-base leading-relaxed font-light sm:text-lg lg:text-xl"
      >
        {weddingService.description}
      </p>
    </div>

    <!-- Gallery & Details Grid -->
    <div class="mt-16 grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Large Showcase Visual (7 Cols) -->
      <div class="reveal lg:col-span-7">
        <div
          class="border-border aspect-[16/10] overflow-hidden border shadow-2xl"
        >
          <img
            src={weddingService.image}
            alt="Luxury Wedding Floral Styling"
            class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
          />
        </div>
      </div>

      <!-- Feature Checklist & CTA (5 Cols) -->
      <div
        class="reveal-right border-border bg-surface-card flex flex-col justify-between border p-8 shadow-xs sm:p-10 lg:col-span-5"
      >
        <div>
          <h2
            class="font-heading text-primary text-2xl font-bold tracking-wide uppercase"
          >
            Rincian Penataan Floral
          </h2>
          <div class="bg-accent my-6 h-[1px] w-16"></div>

          <ul class="flex flex-col gap-4">
            {
              weddingService.features.map((feature) => (
                <li class="text-secondary/90 flex items-start gap-3.5 text-xs leading-relaxed tracking-wider uppercase sm:text-sm">
                  <svg
                    class="text-accent mt-0.5 h-5 w-5 shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  <span>{feature}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="border-border/80 mt-10 border-t pt-6">
          <a
            href={`https://wa.me/${siteConfig.contact.whatsapp}?text=Halo%20Aura%20Fleur,%20saya%20ingin%20konsultasi%20Luxury%20Wedding%20Styling.`}
            target="_blank"
            rel="noopener noreferrer"
            class="border-primary bg-primary hover:bg-primary-hover inline-flex w-full items-center justify-center border py-4 text-xs font-semibold tracking-widest text-white uppercase transition-all duration-300 focus:outline-none"
          >
            Konsultasi Wedding Styling
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
