---
// src/components/sections/services/CorporateSubscription.astro
import { serviceList } from '../../../config/content';
import { siteConfig } from '../../../config/site';

const corporateService = serviceList[1];
---

<section
  class="border-border bg-primary relative border-t py-20 text-white lg:py-32"
>
  <div class="mx-auto max-w-[96rem] px-6 lg:px-12">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Text & Scope Details (7 Cols) -->
      <div class="reveal lg:col-span-7">
        <span
          class="text-accent mb-3 block text-xs font-semibold tracking-[0.3em] uppercase sm:text-sm"
        >
          Hospitality & Office Solutions
        </span>
        <h2
          class="font-heading text-4xl leading-[1.05] font-normal text-white uppercase sm:text-5xl lg:text-6xl"
        >
          {corporateService.title}
        </h2>

        <p
          class="mt-6 text-base leading-relaxed font-light text-white/85 sm:text-lg lg:text-xl"
        >
          {corporateService.description}
        </p>

        <div class="bg-accent/60 my-8 h-[1px] w-24"></div>

        <!-- Features Checklist Grid -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {
            corporateService.features.map((feature) => (
              <div class="flex items-center gap-3 text-xs tracking-wider text-white/90 uppercase sm:text-sm">
                <span class="bg-accent h-2 w-2 rounded-full" />
                <span>{feature}</span>
              </div>
            ))
          }
        </div>

        <div class="mt-10">
          <a
            href={`https://wa.me/${siteConfig.contact.whatsapp}?text=Halo%20Aura%20Fleur,%20saya%20tertarik%20langganan%20bunga%20Corporate%20%26%20Event.`}
            target="_blank"
            rel="noopener noreferrer"
            class="border-accent bg-accent hover:bg-accent-hover inline-flex border px-8 py-4 text-xs font-bold tracking-widest text-white uppercase transition-colors"
          >
            Ajukan Penawaran Korporat
          </a>
        </div>
      </div>

      <!-- Image Visual (5 Cols) -->
      <div class="reveal-right lg:col-span-5">
        <div
          class="relative aspect-[4/5] w-full overflow-hidden border border-white/20 shadow-2xl"
        >
          <img
            src={corporateService.image}
            alt="Corporate Floral Subscription"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>
