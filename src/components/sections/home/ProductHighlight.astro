---
// src/components/sections/home/ProductHighlight.astro
import { productList } from '../../../config/content'
import { siteConfig } from '../../../config/site'

// Ambil 4 produk pertama dari data
const featuredProducts = productList.slice(0, 4)
---

<section class="relative bg-surface py-24 lg:py-36 border-t border-border overflow-hidden">
  <div class="mx-auto max-w-[96rem] px-6 lg:px-12">

    <!-- Header Section -->
    <div class="reveal flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-4xl">
        <span class="mb-3 block text-xs font-semibold uppercase tracking-[0.3em] text-accent sm:text-sm">
          Curated Selection
        </span>
        <h2 class="font-heading text-4xl font-normal uppercase leading-tight text-primary sm:text-6xl lg:text-7xl">
          Koleksi Signature Pilihan
        </h2>
      </div>

      <a
        href="/koleksi"
        class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-primary hover:text-accent transition-colors"
      >
        <span>Lihat Semua Koleksi</span>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

    <!-- Staggered Product Grid (4 Items) -->
    <div class="mt-16 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-10">
      {
        featuredProducts.map((product, index) => {
          // Buat efek staggered: kolom genap (indeks 1 & 3) didorong ke bawah di desktop
          const isStaggered = index % 2 !== 0 ? 'lg:translate-y-12' : ''

          return (
            <div class={`reveal delay-${(index + 1) * 150} group relative flex flex-col justify-between border border-border bg-surface-card p-4 transition-all duration-500 hover:-translate-y-2 hover:shadow-xl ${isStaggered}`}>
              <div>
                <!-- Image Container (Aspect Ratio 3:4) -->
                <div class="relative aspect-[3/4] w-full overflow-hidden border border-border bg-surface">
                  <img
                    src={product.image}
                    alt={product.name}
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />

                  {product.badge && (
                    <span class="absolute top-3 left-3 bg-primary/90 px-3 py-1 text-[10px] font-semibold uppercase tracking-widest text-white backdrop-blur-xs">
                      {product.badge}
                    </span>
                  )}
                </div>

                <!-- Product Info -->
                <div class="mt-5">
                  <span class="text-[10px] font-semibold uppercase tracking-widest text-accent">
                    {product.categoryLabel}
                  </span>
                  <h3 class="font-heading mt-1 text-lg font-bold uppercase tracking-wide text-primary transition-colors group-hover:text-accent">
                    {product.name}
                  </h3>
                  <p class="mt-2 text-xs font-light leading-relaxed text-secondary/70 line-clamp-2">
                    {product.description}
                  </p>
                </div>
              </div>

              <!-- Price & Order Action -->
              <div class="mt-6 border-t border-border/80 pt-4 flex items-center justify-between">
                <div>
                  <span class="block text-[10px] uppercase tracking-wider text-secondary/50">Mulai Dari</span>
                  <span class="font-heading text-sm font-bold text-primary">{product.price}</span>
                </div>

                <a
                  href={`https://wa.me/${siteConfig.contact.whatsapp}?text=Halo%20Aura%20Fleur,%20saya%20tertarik%20memesan%20*${encodeURIComponent(product.name)}*.`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="border border-primary bg-primary px-4 py-2 text-[10px] font-semibold uppercase tracking-widest text-white transition-colors hover:bg-primary-hover"
                >
                  Pesan WA
                </a>
              </div>
            </div>
          )
        })
      }
    </div>

  </div>
</section>