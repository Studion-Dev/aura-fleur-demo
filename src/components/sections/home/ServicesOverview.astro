---
// src/components/sections/home/ServicesOverview.astro
import { serviceList } from '../../../config/content';
---

<section class="bg-surface relative overflow-hidden py-20 lg:py-32">
  <div class="mx-auto max-w-[96rem] px-6 lg:px-12">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- SISI KIRI (7 Cols): Ultra-Minimalist Text -->
      <div class="reveal lg:col-span-7">
        <span
          class="text-accent mb-3 block text-xs font-semibold tracking-[0.3em] uppercase"
        >
          Solusi & Layanan
        </span>
        <h2
          class="font-heading text-primary text-4xl leading-[0.98] font-normal uppercase sm:text-6xl lg:text-7xl"
        >
          Rangkaian Seni Floral Bespoke
        </h2>

        <!-- Minimalist Service Pillars -->
        <div
          class="divide-border border-border mt-12 flex flex-col divide-y border-y"
        >
          {
            serviceList.map((service, index) => (
              <a
                href="/koleksi"
                class="group hover:bg-surface-card/50 flex items-center justify-between py-6 transition-colors"
              >
                <div class="flex items-center gap-6">
                  <span class="font-heading text-accent text-sm font-bold">
                    0{index + 1}
                  </span>
                  <h3 class="font-heading text-primary group-hover:text-accent text-2xl font-bold uppercase transition-colors sm:text-3xl">
                    {service.title}
                  </h3>
                </div>

                <div class="border-primary text-primary group-hover:bg-primary flex h-10 w-10 items-center justify-center border transition-all group-hover:text-white">
                  <svg
                    class="h-4 w-4 -rotate-45 transition-transform duration-300 group-hover:rotate-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M14 5l7 7m0 0l-7 7m7-7H3"
                    />
                  </svg>
                </div>
              </a>
            ))
          }
        </div>
      </div>

      <!-- SISI KANAN (5 Cols): Clean Visual Focus -->
      <div class="reveal-right relative lg:col-span-5">
        <div
          class="border-border relative mx-auto aspect-[4/5] w-full max-w-md overflow-hidden border shadow-2xl"
        >
          <img
            src={serviceList[0].image}
            alt="Luxury Wedding Floral"
            class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
          />
          <div
            class="from-primary/70 absolute inset-0 bg-gradient-to-t via-transparent to-transparent"
          >
          </div>
          <div class="absolute bottom-6 left-6 text-white">
            <span
              class="font-heading text-accent text-xs font-bold tracking-widest uppercase"
              >Haute Couture</span
            >
            <p class="font-heading mt-0.5 text-xl font-bold uppercase">
              Wedding & Event Installations
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
