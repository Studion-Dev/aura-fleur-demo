---
// src/components/sections/home/QualityDeepDive.astro
import { homeContent } from '../../../config/content';
import { siteConfig } from '../../../config/site';

const { tagline, title, features } = homeContent.qualityDeepDive;
---

<section
  class="bg-primary border-border relative overflow-hidden border-t py-20 text-white lg:py-32"
>
  <div class="mx-auto max-w-[96rem] px-6 lg:px-12">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- SISI KIRI (6 Cols): Clean Split Visual -->
      <div class="reveal lg:col-span-6">
        <div
          class="relative aspect-[4/5] w-full overflow-hidden border border-white/20 shadow-2xl"
        >
          <img
            src="https://images.unsplash.com/photo-1526047932273-341f2a7631f9?q=80&w=1000&auto=format&fit=crop"
            alt="Cold-Chain Care"
            class="h-full w-full object-cover"
          />
        </div>
      </div>

      <!-- SISI KANAN (6 Cols): Minimalist Points -->
      <div class="reveal-right lg:col-span-6">
        <span
          class="text-accent mb-3 block text-xs font-semibold tracking-[0.3em] uppercase"
        >
          {tagline}
        </span>
        <h2
          class="font-heading text-4xl leading-tight font-normal text-white uppercase sm:text-5xl lg:text-6xl"
        >
          {title}
        </h2>

        <!-- Clean Bold List (Tanpa Teks Kecil Berisik) -->
        <div
          class="mt-10 flex flex-col divide-y divide-white/10 border-y border-white/10"
        >
          {
            features.map((feature, index) => (
              <div class="flex items-center gap-6 py-5">
                <span class="font-heading text-accent text-xl font-bold">
                  0{index + 1}
                </span>
                <h3 class="font-heading text-xl font-bold tracking-wide text-white uppercase sm:text-2xl">
                  {feature.title}
                </h3>
              </div>
            ))
          }
        </div>

        <div class="mt-10">
          <a
            href={`https://wa.me/${siteConfig.contact.whatsapp}?text=Halo%20Aura%20Fleur,%20saya%20ingin%20tanya%20mengenai%20garansi%20pengiriman%20segar.`}
            target="_blank"
            rel="noopener noreferrer"
            class="border-accent bg-accent hover:bg-accent-hover inline-flex border px-8 py-4 text-xs font-bold tracking-widest text-white uppercase transition-all hover:scale-105"
          >
            Konsultasi Standar Kesegaran
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
