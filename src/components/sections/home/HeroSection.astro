---
// src/components/sections/home/HeroSection.astro
import { homeContent } from '../../../config/content';
import { siteConfig } from '../../../config/site';

const primaryStat = homeContent.stats[0];
---

<section class="bg-surface relative w-full overflow-hidden lg:h-screen">
  <div class="h-full w-full">
    <div class="grid h-full grid-cols-1 items-stretch lg:grid-cols-2">
      <!-- SISI KIRI (50% / Col 1): Content & Pattern Background -->
      <div
        class="relative flex flex-col justify-between px-6 pt-28 pb-0 lg:pt-36 lg:pr-10 lg:pl-16"
      >
        <!-- Luxury Grid Pattern Background (Garis Lebih Jelas & Standout) -->
        <div
          class="reveal-left pointer-events-none absolute inset-0 -z-0 delay-600"
        >
          <svg
            class="h-full w-full"
            width="100%"
            height="100%"
            xmlns="http://www.w3.org/2000/svg"
          >
            <defs>
              <pattern
                id="luxury-grid"
                width="48"
                height="48"
                patternUnits="userSpaceOnUse"
              >
                <path
                  d="M 48 0 L 0 0 0 48"
                  fill="none"
                  stroke="#D4CEA3"
                  stroke-width="1.2"
                  opacity="0.4"></path>
              </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#luxury-grid)"></rect>
          </svg>
          <div
            class="via-surface/40 to-surface absolute inset-0 bg-radial from-transparent"
          >
          </div>
        </div>

        <!-- Headline Block (Normal Container Boundary) -->
        <div class="relative z-10 max-w-xl">
          <h1
            class="font-heading reveal-left text-primary text-4xl leading-[0.95] font-semibold tracking-tight uppercase delay-600 sm:text-6xl lg:text-7xl"
          >
            <span class="text-secondary/40 block font-light">SENI FLORAL,</span>
            <span class="text-primary mt-1 block">KEANGGUNAN</span>
            <span class="text-accent block">TANPA BATAS</span>
          </h1>

          <!-- 2 Action Buttons -->
          <div class="mt-10 flex flex-wrap items-center gap-4">
            <a
              href="/koleksi"
              class="border-primary reveal bg-primary hover:bg-primary-hover border px-8 py-3.5 text-xs font-semibold tracking-widest text-white uppercase shadow-md transition-all delay-900 duration-300 focus:outline-none"
            >
              {homeContent.hero.ctaPrimary}
            </a>
            <a
              href={`https://wa.me/${siteConfig.contact.whatsapp}?text=Halo%20Aura%20Fleur,%20saya%20ingin%20konsultasi%20bespoke%20floral.`}
              target="_blank"
              rel="noopener noreferrer"
              class="border-border reveal bg-surface/80 text-primary hover:border-accent hover:text-accent border px-8 py-3.5 text-xs font-semibold tracking-widest uppercase shadow-xs backdrop-blur-sm transition-all delay-1000 duration-300 focus:outline-none"
            >
              {homeContent.hero.ctaSecondary}
            </a>
          </div>
        </div>

        <!-- Bottom Area: Secondary Image (Landscape Mentok Bawah) -->
        <div
          class="reveal relative z-10 mt-10 mb-10 delay-1300 lg:mt-0 lg:mb-0"
        >
          <div
            class="border-border relative aspect-[21/9] w-full max-w-md overflow-hidden border-t border-r border-l shadow-md"
          >
            <img
              src="https://images.unsplash.com/photo-1526047932273-341f2a7631f9?q=80&w=1000&auto=format&fit=crop"
              alt="Atelier Crafting Process"
              class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
            />
            <div
              class="from-primary/40 absolute inset-0 bg-gradient-to-t via-transparent to-transparent"
            >
            </div>
            <span
              class="font-heading absolute bottom-3 left-4 text-[10px] tracking-widest text-white uppercase"
            >
              Atelier Detail & Craftsmanship
            </span>
          </div>
        </div>
      </div>

      <!-- SISI KANAN (50% / Col 2): Hero Image Full Screen Height -->
      <div class="relative min-h-[450px] w-full lg:h-full">
        <img
          src="https://images.unsplash.com/photo-1563241527-3004b7be0ffd?q=80&w=1200&auto=format&fit=crop"
          alt="Aura Fleur Signature Luxury Arrangement"
          class="reveal-right h-full w-full object-cover delay-700"
          loading="eager"
        />

        <div
          class="from-primary/50 reveal-right absolute inset-0 bg-gradient-to-t via-transparent to-transparent delay-700"
        >
        </div>

        <!-- FLOATING GLASS CARD (Persis Sesuai Style Gambar Referensi) -->
        <div
          class="reveal absolute right-6 bottom-10 left-6 z-20 border border-white/50 bg-white/75 p-6 shadow-xl backdrop-blur-md transition-all delay-1400 duration-300 sm:right-auto sm:left-8 sm:w-80"
        >
          <!-- Top Row: Avatar Stack + Arrow Circle Button -->
          <div class="flex items-center justify-between">
            <div class="flex -space-x-2.5 overflow-hidden">
              <img
                class="inline-block h-9 w-9 rounded-full object-cover ring-2 ring-white"
                src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=100&auto=format&fit=crop"
                alt="VIP Client"
              />
              <img
                class="inline-block h-9 w-9 rounded-full object-cover ring-2 ring-white"
                src="https://images.unsplash.com/photo-1517841905240-472988babdf9?q=80&w=100&auto=format&fit=crop"
                alt="VIP Client"
              />
              <img
                class="inline-block h-9 w-9 rounded-full object-cover ring-2 ring-white"
                src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=100&auto=format&fit=crop"
                alt="VIP Client"
              />
            </div>

            <!-- Arrow Circle Button -->
            <a
              href="/tentang-kami"
              class="bg-primary hover:bg-accent flex h-10 w-10 items-center justify-center rounded-full text-white shadow-md transition-transform duration-300 hover:scale-110"
              aria-label="Lihat Tentang Kami"
            >
              <svg
                class="h-4 w-4 -rotate-45"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
          </div>

          <!-- Bottom Row: Stat Number & Description -->
          <div class="mt-5">
            <div
              class="font-heading text-primary text-3xl font-bold tracking-tight sm:text-4xl"
            >
              <span>Over </span>
              <span class="counter" data-target="99">0</span>
              <span>%</span>
            </div>
            <p class="text-secondary/80 mt-1 text-xs leading-snug font-medium">
              Kepuasan Klien VIP & Corporate Event pilihan Aura Fleur.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
