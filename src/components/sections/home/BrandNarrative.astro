---
// src/components/sections/home/BrandNarrative.astro
import { homeContent } from '../../../config/content';
---

<section
  class="border-border bg-surface relative overflow-hidden border-t py-20 lg:py-32"
>
  <!-- Container Lebar (Mepet Screen) & Spacious -->
  <div class="mx-auto max-w-[96rem] px-6 lg:px-12">
    <div class="grid grid-cols-1 items-center gap-16 lg:grid-cols-12 lg:gap-20">
      <!-- LEFT SIDE: Editorial Typography Story (7 Cols) -->
      <div class="reveal lg:col-span-7">
        <!-- Subtitle Lebih Jelas & Standout -->
        <span
          class="text-accent mb-4 block text-xs font-semibold tracking-[0.3em] uppercase sm:text-sm"
        >
          {homeContent.brandNarrative.subtitle}
        </span>

        <!-- Standout Heading Ukuran Raksasa -->
        <h2
          class="font-heading text-primary text-4xl leading-[1.02] font-normal uppercase sm:text-6xl lg:text-7xl"
        >
          {homeContent.brandNarrative.title}
        </h2>

        <!-- Accent Line -->
        <div class="bg-accent my-8 h-[2px] w-32"></div>

        <!-- Body Narrative (Font Size Upgraded) -->
        <p
          class="text-secondary/85 max-w-3xl text-base leading-relaxed font-light sm:text-lg lg:text-xl"
        >
          {homeContent.brandNarrative.description}
        </p>

        <!-- Feature Columns (Font & Space Upgraded) -->
        <div
          class="border-border/80 mt-12 grid grid-cols-1 gap-8 border-t pt-8 sm:grid-cols-2"
        >
          <div>
            <h3
              class="font-heading text-primary text-base font-semibold tracking-wider uppercase sm:text-lg"
            >
              Ecuadorian & Dutch Roses
            </h3>
            <p
              class="text-secondary/75 mt-2 text-sm leading-relaxed sm:text-base"
            >
              Dikurasi dan diimpor langsung secara segar setiap minggu dengan
              standar kesegaran dan bentuk kelopak tertinggi[cite: 4, 8].
            </p>
          </div>
          <div>
            <h3
              class="font-heading text-primary text-base font-semibold tracking-wider uppercase sm:text-lg"
            >
              Bespoke Arrangement
            </h3>
            <p
              class="text-secondary/75 mt-2 text-sm leading-relaxed sm:text-base"
            >
              Setiap tangkai bunga disusun secara personal oleh master florist
              untuk mengekspresikan cerita momen berharga Anda.
            </p>
          </div>
        </div>

        <div class="mt-12">
          <a
            href="/tentang-kami"
            class="group text-primary hover:text-accent inline-flex items-center gap-4 text-xs font-bold tracking-widest uppercase transition-colors sm:text-sm"
          >
            <span
              class="border-primary group-hover:border-accent border-b transition-colors"
            >
              Baca Selengkapnya Tentang Kami
            </span>
            <svg
              class="h-5 w-5 transition-transform group-hover:translate-x-1.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- RIGHT SIDE: Dual Layered Visual Showcase (5 Cols) -->
      <div class="reveal-right relative lg:col-span-5">
        <div class="relative mx-auto max-w-lg lg:max-w-none">
          <!-- Main Image Large -->
          <div
            class="border-border aspect-[3/4] overflow-hidden border shadow-2xl"
          >
            <img
              src="https://images.unsplash.com/photo-1561181286-d3fee7d55364?q=80&w=1200&auto=format&fit=crop"
              alt="Artisanal Floral Craftsmanship"
              class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
              loading="lazy"
            />
          </div>

          <!-- Small Overlay Image -->
          <div
            class="border-surface absolute -bottom-10 -left-10 hidden aspect-square w-3/5 border-8 shadow-2xl sm:block"
          >
            <img
              src="https://images.unsplash.com/photo-1508615070457-7baeba4003ab?q=80&w=600&auto=format&fit=crop"
              alt="Floral Detail Close Up"
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </div>

          <!-- Accent Est Tag -->
          <div
            class="border-accent/40 bg-primary absolute top-6 right-6 border px-4 py-2 text-center text-xs font-semibold tracking-widest text-white uppercase shadow-lg"
          >
            Est. 2018
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
