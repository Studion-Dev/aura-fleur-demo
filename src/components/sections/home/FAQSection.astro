---
// src/components/sections/home/FAQSection.astro
import { faqList } from '../../../config/content'
---

<section class="relative bg-surface py-24 lg:py-36 border-t border-border">
  <div class="mx-auto max-w-[96rem] px-6 lg:px-12">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">

      <!-- SISI KIRI (5 Cols): Header Title -->
      <div class="reveal lg:col-span-5">
        <span class="mb-3 block text-xs font-semibold uppercase tracking-[0.3em] text-accent sm:text-sm">
          Frequently Asked Questions
        </span>
        <h2 class="font-heading text-4xl font-normal uppercase leading-tight text-primary sm:text-6xl">
          Pertanyaan Umum
        </h2>
        <p class="mt-6 text-sm font-light leading-relaxed text-secondary/80 sm:text-base">
          Informasi seputar standar pemesanan, pengiriman berpendingin khusus, hingga kustomisasi rangkaian bunga eksklusif kami.
        </p>
      </div>

      <!-- SISI KANAN (7 Cols): Accordion List (Alpine.js) -->
      <div class="reveal-right lg:col-span-7" x-data="{ activeAccordion: null }">
        <div class="flex flex-col divide-y divide-border border-y border-border">
          {
            faqList.map((faq, index) => (
              <div class="py-6 sm:py-8">
                <button
                  @click={`activeAccordion = (activeAccordion === ${index}) ? null : ${index}`}
                  class="flex w-full items-center justify-between text-left focus:outline-none"
                  aria-expanded="false"
                >
                  <span class="font-heading text-lg font-bold uppercase tracking-wide text-primary sm:text-xl pr-4">
                    {faq.question}
                  </span>
                  <span class="ml-4 flex h-8 w-8 shrink-0 items-center justify-center border border-primary text-primary transition-transform duration-300" :class={`{ 'rotate-45 bg-primary text-white': activeAccordion === ${index} }`}>
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                  </span>
                </button>

                <div
                  x-show={`activeAccordion === ${index}`}
                  x-collapse
                  class="mt-4 pr-12"
                >
                  <p class="text-xs font-light leading-relaxed text-secondary/80 sm:text-sm">
                    {faq.answer}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

    </div>
  </div>
</section>