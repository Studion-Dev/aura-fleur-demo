---
// src/components/sections/home/CuratedPreview.astro
import { productList } from '../../../config/content';
import ProductCard from '../../ui/ProductCard.astro';

// Tampilkan 4 produk pilihan pertama di Homepage
const featuredProducts = productList.slice(0, 4);
---

<section class="border-border bg-surface relative border-t py-20 lg:py-32">
  <!-- Container Lebar (Mepet Screen) & Spacious -->
  <div class="mx-auto max-w-[96rem] px-6 lg:px-12">
    <!-- Section Header Editorial -->
    <div
      class="reveal flex flex-col justify-between gap-6 md:flex-row md:items-end"
    >
      <div>
        <span
          class="text-accent mb-3 block text-xs font-semibold tracking-[0.3em] uppercase sm:text-sm"
        >
          Signature Selection
        </span>
        <h2
          class="font-heading text-primary text-4xl leading-tight font-normal uppercase sm:text-6xl lg:text-7xl"
        >
          Koleksi Kurasi Pilihan
        </h2>
      </div>

      <div class="mb-2">
        <a
          href="/koleksi"
          class="group text-primary hover:text-accent inline-flex items-center gap-3 text-xs font-bold tracking-widest uppercase transition-colors sm:text-sm"
        >
          <span
            class="border-primary group-hover:border-accent border-b transition-colors"
          >
            Lihat Semua Koleksi
          </span>
          <svg
            class="h-5 w-5 transition-transform group-hover:translate-x-1.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Product Cards Grid (4 Columns Spacious) -->
    <div
      class="mt-16 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8"
    >
      {
        featuredProducts.map((product, index) => (
          <div class={`reveal delay-${(index + 1) * 100}`}>
            <ProductCard product={product} />
          </div>
        ))
      }
    </div>
  </div>
</section>
