---
// src/components/sections/home/CtaBanner.astro
import { siteConfig } from '../../../config/site';
---

<section
  class="bg-primary border-border relative overflow-hidden border-t py-28 text-white lg:py-40"
>
  <!-- Subtle Luxury Grid Pattern Background -->
  <div class="pointer-events-none absolute inset-0 opacity-10">
    <svg
      class="h-full w-full"
      width="100%"
      height="100%"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <pattern
          id="cta-grid"
          width="48"
          height="48"
          patternUnits="userSpaceOnUse"
        >
          <path
            d="M 48 0 L 0 0 0 48"
            fill="none"
            stroke="#D4CEA3"
            stroke-width="1.2"></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#cta-grid)"></rect>
    </svg>
  </div>

  <!-- Ambient Glow Center -->
  <div
    class="bg-accent/15 pointer-events-none absolute top-1/2 left-1/2 h-96 w-96 -translate-x-1/2 -translate-y-1/2 rounded-full blur-3xl"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-5xl px-6 text-center lg:px-12">
    <!-- Subtitle -->
    <span
      class="reveal text-accent mb-4 block text-xs font-semibold tracking-[0.3em] uppercase sm:text-sm"
    >
      Private Consultation & Bespoke Order
    </span>

    <!-- Main Title -->
    <h2
      class="reveal font-heading text-4xl leading-[1.05] font-normal text-white uppercase sm:text-6xl lg:text-7xl"
    >
      Wujudkan Estetika Floral Impian Anda Bersama Master Florist Kami
    </h2>

    <p
      class="reveal mt-6 text-sm leading-relaxed font-light text-white/80 sm:text-base lg:text-lg"
    >
      Siap merancang momen tak terlupakan? Jadwalkan sesi konsultasi private
      atau pesan rangkaian bunga bespoke secara langsung melalui WhatsApp
      Concierge kami.
    </p>

    <!-- Action Buttons -->
    <div class="reveal mt-10 flex flex-wrap items-center justify-center gap-5">
      <a
        href={`https://wa.me/${siteConfig.contact.whatsapp}?text=Halo%20Aura%20Fleur,%20saya%20ingin%20konsultasi%20bespoke%20floral.`}
        target="_blank"
        rel="noopener noreferrer"
        class="border-accent bg-accent hover:bg-accent-hover border px-9 py-4 text-xs font-bold tracking-widest text-white uppercase shadow-lg transition-all duration-300 hover:scale-105"
      >
        Konsultasi via WhatsApp Direct
      </a>

      <a
        href="/kontak"
        class="hover:border-accent hover:text-accent border border-white/30 bg-white/5 px-9 py-4 text-xs font-bold tracking-widest text-white uppercase backdrop-blur-xs transition-all duration-300 hover:bg-white/10"
      >
        Kunjungi Atelier Kami
      </a>
    </div>
  </div>
</section>
