---
// src/components/sections/home/TestimonialSection.astro
import { clientTestimonials } from '../../../config/content'
---

<section class="relative bg-surface py-24 lg:py-36 border-t border-border overflow-hidden">
  <div class="mx-auto max-w-[96rem] px-6 lg:px-12">

    <!-- Alpine.js Slider State Container -->
    <div x-data={`{ activeIndex: 0, total: ${clientTestimonials.length} }`} class="relative">

      <!-- Section Header & Navigation Buttons -->
      <div class="reveal flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div class="max-w-xl">
          <span class="mb-3 block text-xs font-semibold uppercase tracking-[0.3em] text-accent sm:text-sm">
            Client Impressions
          </span>
          <h2 class="font-heading text-4xl font-normal uppercase leading-tight text-primary sm:text-6xl lg:text-7xl">
            Suara Klien VIP & Partner
          </h2>
        </div>

        <!-- Custom Navigation Arrows -->
        <div class="flex items-center gap-3">
          <button
            @click="activeIndex = (activeIndex === 0) ? total - 1 : activeIndex - 1"
            class="flex h-12 w-12 items-center justify-center border border-primary text-primary transition-colors hover:bg-primary hover:text-white"
            aria-label="Previous Testimonial"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
          </button>

          <button
            @click="activeIndex = (activeIndex === total - 1) ? 0 : activeIndex + 1"
            class="flex h-12 w-12 items-center justify-center border border-primary text-primary transition-colors hover:bg-primary hover:text-white"
            aria-label="Next Testimonial"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Testimonial Content Wrapper -->
      <div class="relative mt-16 border border-border bg-surface-card p-8 sm:p-12 lg:p-16 shadow-xl">

        <!-- Large Decorative Background Quote Mark -->
        <span class="pointer-events-none absolute top-4 right-8 select-none font-heading text-[12rem] font-bold leading-none text-accent/10 sm:text-[18rem]">
          “
        </span>

        <!-- Testimonial Items (Controlled by Alpine) -->
        {
          clientTestimonials.map((item, index) => (
            <div
              x-show={`activeIndex === ${index}`}
              x-transition:enter="transition ease-out duration-500"
              x-transition:enter-start="opacity-0 translate-x-4"
              x-transition:enter-end="opacity-100 translate-x-0"
              class="relative z-10 flex flex-col justify-between"
            >
              <div>
                <!-- Stars -->
                <div class="flex items-center gap-1 text-accent">
                  {Array.from({ length: item.rating }).map(() => (
                    <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  ))}
                </div>

                <!-- Quote Body -->
                <blockquote class="font-heading mt-8 text-xl font-normal italic leading-relaxed text-primary sm:text-2xl lg:text-3xl">
                  "{item.quote}"
                </blockquote>
              </div>

              <!-- Author Details -->
              <div class="mt-12 border-t border-border pt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                <div>
                  <h3 class="font-heading text-lg font-bold uppercase tracking-wider text-primary">
                    {item.clientName}
                  </h3>
                  <p class="text-xs font-semibold uppercase tracking-widest text-accent mt-0.5">
                    {item.role} — {item.event}
                  </p>
                </div>

                <!-- Slide Index Indicator -->
                <span class="font-heading text-xs font-bold uppercase tracking-widest text-secondary/50">
                  0{index + 1} / 0{clientTestimonials.length}
                </span>
              </div>
            </div>
          ))
        }

      </div>

    </div>

  </div>
</section>