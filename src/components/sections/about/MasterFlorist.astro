---
// src/components/sections/about/MasterFlorist.astro
import { aboutContent } from '../../../config/content';
---

<section
  class="border-border bg-primary relative border-t py-20 text-white lg:py-32"
>
  <div class="mx-auto max-w-[96rem] px-6 lg:px-12">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Left Image Portrait -->
      <div class="reveal lg:col-span-5">
        <div
          class="relative aspect-[3/4] w-full overflow-hidden border border-white/20 shadow-2xl"
        >
          <img
            src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=1000&auto=format&fit=crop"
            alt={aboutContent.masterFlorist.name}
            class="h-full w-full object-cover"
          />
        </div>
      </div>

      <!-- Right Bio & Vision -->
      <div class="reveal-right lg:col-span-7">
        <span
          class="text-accent mb-3 block text-xs font-semibold tracking-[0.3em] uppercase sm:text-sm"
        >
          Master Florist Profile
        </span>
        <h2
          class="font-heading text-4xl font-normal text-white uppercase sm:text-5xl lg:text-6xl"
        >
          {aboutContent.masterFlorist.name}
        </h2>
        <p
          class="text-accent mt-2 text-xs font-semibold tracking-widest uppercase"
        >
          {aboutContent.masterFlorist.role}
        </p>

        <div class="bg-accent/60 my-8 h-[1px] w-24"></div>

        <p
          class="text-base leading-relaxed font-light text-white/85 sm:text-lg lg:text-xl"
        >
          {aboutContent.masterFlorist.bio}
        </p>

        <blockquote
          class="border-accent font-heading text-accent mt-8 border-l-2 pl-6 text-lg italic sm:text-xl"
        >
          "Merangkai bunga adalah seni menerjemahkan emosi dan merayakan momen
          hidup yang tak ternilai."
        </blockquote>
      </div>
    </div>
  </div>
</section>
