---
// src/components/sections/about/MasterFlorist.astro
import { aboutContent } from '../../../config/content';
const { name, role, bio } = aboutContent.masterFlorist;
---

<section
  class="bg-primary border-border relative overflow-hidden border-t py-20 text-white lg:py-32"
>
  <div class="mx-auto max-w-[96rem] px-6 lg:px-12">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Left Column (5 Cols): Portrait Image -->
      <div class="reveal lg:col-span-5">
        <div
          class="relative aspect-[4/5] w-full overflow-hidden border border-white/20 shadow-2xl"
        >
          <img
            src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=1000&auto=format&fit=crop"
            alt={name}
            class="h-full w-full object-cover"
          />
        </div>
      </div>

      <!-- Right Column (7 Cols): Profile & Quote -->
      <div class="reveal-right lg:col-span-7">
        <span
          class="text-accent mb-3 block text-xs font-semibold tracking-[0.3em] uppercase"
        >
          Lead Artisan & Creative Director
        </span>
        <h2
          class="font-heading text-4xl leading-tight font-normal text-white uppercase sm:text-5xl lg:text-6xl"
        >
          {name}
        </h2>
        <p
          class="font-heading text-accent mt-1 text-xs tracking-widest uppercase"
        >
          {role}
        </p>

        <blockquote
          class="font-heading mt-8 text-xl leading-relaxed font-normal text-white/90 italic sm:text-2xl"
        >
          "{bio}"
        </blockquote>
      </div>
    </div>
  </div>
</section>
