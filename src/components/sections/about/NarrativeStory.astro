---
// src/components/sections/about/NarrativeStory.astro
import { homeContent } from '../../../config/content';
---

<section class="bg-surface relative overflow-hidden py-20 lg:py-32">
  <div class="mx-auto max-w-[96rem] px-6 lg:px-12">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Left Column (7 Cols): Asymmetric Narrative Text -->
      <div class="reveal lg:col-span-7">
        <span
          class="text-accent mb-3 block text-xs font-semibold tracking-[0.3em] uppercase"
        >
          {homeContent.brandNarrative.subtitle}
        </span>
        <h2
          class="font-heading text-primary text-4xl leading-[1.02] font-normal uppercase sm:text-5xl lg:text-6xl"
        >
          {homeContent.brandNarrative.title}
        </h2>

        <p
          class="text-secondary/80 mt-8 max-w-2xl text-base leading-relaxed font-light sm:text-lg lg:text-xl"
        >
          {homeContent.brandNarrative.description}
        </p>
      </div>

      <!-- Right Column (5 Cols): Floating Asymmetric Visual -->
      <div class="reveal-right lg:col-span-5">
        <div
          class="border-border relative mx-auto aspect-[3/4] w-full max-w-md overflow-hidden border shadow-2xl"
        >
          <img
            src="https://images.unsplash.com/photo-1526047932273-341f2a7631f9?q=80&w=1000&auto=format&fit=crop"
            alt="Floral Craftsmanship"
            class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
          />
        </div>
      </div>
    </div>
  </div>
</section>
