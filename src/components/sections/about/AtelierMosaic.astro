---
// src/components/sections/about/AtelierMosaic.astro
const images = [
  'https://images.unsplash.com/photo-1563241527-3004b7be0ffd?q=80&w=800&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1508615070457-7baeba4003ab?q=80&w=800&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1519225421980-715cb0215aed?q=80&w=800&auto=format&fit=crop',
];
---

<section
  class="bg-surface border-border relative overflow-hidden border-t py-20 lg:py-32"
>
  <div class="mx-auto max-w-[96rem] px-6 lg:px-12">
    <div class="reveal mb-12 max-w-xl">
      <span
        class="text-accent mb-3 block text-xs font-semibold tracking-[0.3em] uppercase"
      >
        Behind The Scenes
      </span>
      <h2
        class="font-heading text-primary text-3xl font-normal uppercase sm:text-5xl"
      >
        Atelier & Process
      </h2>
    </div>

    <!-- Staggered Mosaic 3 Photos -->
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-3 lg:gap-8">
      {
        images.map((img, index) => {
          const isOffset = index === 1 ? 'sm:translate-y-8' : '';
          return (
            <div
              class={`reveal delay-${(index + 1) * 150} border-border aspect-[3/4] overflow-hidden border ${isOffset}`}
            >
              <img
                src={img}
                alt="Atelier Process"
                class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
              />
            </div>
          );
        })
      }
    </div>
  </div>
</section>
