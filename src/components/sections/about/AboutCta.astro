---
// src/components/sections/about/AboutCta.astro
import { siteConfig } from '../../../config/site';
---

<section
  class="bg-primary border-border relative overflow-hidden border-t py-24 text-white lg:py-36"
>
  <div class="relative z-10 mx-auto max-w-4xl px-6 text-center lg:px-12">
    <span
      class="reveal text-accent mb-3 block text-xs font-semibold tracking-[0.3em] uppercase"
    >
      Private Consultation
    </span>

    <h2
      class="reveal font-heading text-4xl leading-tight font-normal text-white uppercase sm:text-6xl"
    >
      Mari Bicara Tentang Visi Floral Anda
    </h2>

    <div class="reveal mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href={`https://wa.me/${siteConfig.contact.whatsapp}?text=Halo%20Aura%20Fleur,%20saya%20ingin%20konsultasi%20mengenai%20bespoke%20floral.`}
        target="_blank"
        rel="noopener noreferrer"
        class="border-accent bg-accent hover:bg-accent-hover border px-9 py-4 text-xs font-bold tracking-widest text-white uppercase transition-all hover:scale-105"
      >
        WhatsApp Direct
      </a>

      <a
        href="/kontak"
        class="hover:border-accent hover:text-accent border border-white/30 bg-white/5 px-9 py-4 text-xs font-bold tracking-widest text-white uppercase backdrop-blur-xs transition-all"
      >
        Janji Temu Atelier
      </a>
    </div>
  </div>
</section>
