---
// src/pages/koleksi/[id].astro
import MainLayout from '../../layouts/Layout.astro';
import { productList } from '../../config/content';
import { siteConfig } from '../../config/site';

// 1. Generate path untuk seluruh 20 produk secara statis saat build
export async function getStaticPaths() {
  return productList.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;

// Ambil 3 produk rekomendasi lain untuk bagian "You May Also Like"
const relatedProducts = productList
  .filter((p) => p.id !== product.id)
  .slice(0, 3);
---

<MainLayout title={`${product.name} — Aura Fleur`}>
  <!-- Detail Section Header / Breadcrumb Minimalis -->
  <section class="bg-surface border-border relative border-b pt-32 pb-12">
    <div class="mx-auto max-w-[96rem] px-6 lg:px-12">
      <a
        href="/koleksi"
        class="text-secondary hover:text-accent inline-flex items-center gap-2 text-xs font-bold tracking-widest uppercase transition-colors"
      >
        <svg
          class="h-4 w-4 rotate-180"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
        <span>Kembali ke Koleksi</span>
      </a>
    </div>
  </section>

  <!-- Product Detail Showcase (Split Screen) -->
  <section class="bg-surface relative py-16 lg:py-24">
    <div class="mx-auto max-w-[96rem] px-6 lg:px-12">
      <div
        class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-16"
      >
        <!-- SISI KIRI (7 Cols): Foto Produk HD -->
        <div class="reveal lg:col-span-7">
          <div
            class="border-border bg-surface-card relative aspect-[3/4] w-full overflow-hidden border shadow-2xl"
          >
            <img
              src={product.image}
              alt={product.name}
              class="h-full w-full object-cover"
            />
            {
              product.badge && (
                <span class="bg-primary absolute top-4 left-4 px-4 py-2 text-xs font-bold tracking-widest text-white uppercase backdrop-blur-xs">
                  {product.badge}
                </span>
              )
            }
          </div>
        </div>

        <!-- SISI KANAN (5 Cols): Deskripsi, Spesifikasi & Order WA Direct -->
        <div
          class="reveal-right flex flex-col justify-between lg:sticky lg:top-28 lg:col-span-5"
        >
          <div>
            <span
              class="text-accent text-xs font-bold tracking-[0.25em] uppercase"
            >
              {product.categoryLabel}
            </span>
            <h1
              class="font-heading text-primary mt-2 text-3xl leading-tight font-normal uppercase sm:text-5xl"
            >
              {product.name}
            </h1>

            <div class="mt-4 flex items-baseline gap-3">
              <span
                class="text-secondary/60 block text-xs tracking-wider uppercase"
                >Investasi / Harga:</span
              >
              <span class="font-heading text-primary text-2xl font-bold"
                >{product.price}</span
              >
            </div>

            <div class="bg-accent/60 my-6 h-[1px] w-16"></div>

            <p class="text-secondary/80 text-base leading-relaxed font-light">
              {product.description}
            </p>

            <!-- Detail Spesifikasi & Perawatan (Clean Spec Table) -->
            <div
              class="border-border mt-8 flex flex-col gap-3 border-t border-b py-6 text-sm"
            >
              <div class="flex justify-between">
                <span
                  class="text-secondary/60 font-bold tracking-wider uppercase"
                  >Standar Bunga</span
                >
                <span class="text-primary font-semibold"
                  >Direct Import & Selection</span
                >
              </div>
              <div class="flex justify-between">
                <span
                  class="text-secondary/60 font-bold tracking-wider uppercase"
                  >Penanganan Suhu</span
                >
                <span class="text-primary font-semibold">Cold-Chain 2–5°C</span>
              </div>
              <div class="flex justify-between">
                <span
                  class="text-secondary/60 font-bold tracking-wider uppercase"
                  >Pengiriman</span
                >
                <span class="text-primary font-semibold"
                  >White-Glove Vehicle</span
                >
              </div>
            </div>
          </div>

          <!-- Order Action Box -->
          <div class="mt-8">
            <a
              href={`https://wa.me/${siteConfig.contact.whatsapp}?text=Halo%20Aura%20Fleur,%20saya%20ingin%20memesan%20rangkaian%20*${encodeURIComponent(product.name)}*%20(${product.price}).`}
              target="_blank"
              rel="noopener noreferrer"
              class="border-accent bg-accent hover:bg-accent-hover block w-full border py-4 text-center text-xs font-bold tracking-widest text-white uppercase transition-all hover:scale-[1.01] sm:text-sm"
            >
              Pesan Rangkaian Ini via WA Direct
            </a>
            <p class="text-secondary/60 mt-3 text-center text-xs">
              * Konsultasi kustomisasi warna & kartu ucapan gratis saat
              pemesanan.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Products (3 Items) -->
  <section class="bg-surface border-border relative border-t py-20">
    <div class="mx-auto max-w-[96rem] px-6 lg:px-12">
      <div class="mb-10">
        <span class="text-accent text-xs font-bold tracking-[0.25em] uppercase"
          >Curated Selection</span
        >
        <h2
          class="font-heading text-primary mt-1 text-2xl font-normal uppercase sm:text-4xl"
        >
          Rangkaian Pilihan Lainnya
        </h2>
      </div>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
        {
          relatedProducts.map((rel) => (
            <a
              href={`/koleksi/${rel.id}`}
              class="group border-border bg-surface-card relative border p-4 transition-all hover:-translate-y-1"
            >
              <div class="border-border aspect-[3/4] overflow-hidden border">
                <img
                  src={rel.image}
                  alt={rel.name}
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
              </div>
              <div class="mt-4">
                <span class="text-accent text-xs font-bold uppercase">
                  {rel.categoryLabel}
                </span>
                <h3 class="font-heading text-primary group-hover:text-accent mt-1 text-lg font-bold uppercase transition-colors">
                  {rel.name}
                </h3>
                <span class="font-heading text-primary mt-2 block text-sm font-bold">
                  {rel.price}
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</MainLayout>
